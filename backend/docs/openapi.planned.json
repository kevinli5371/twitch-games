    "/api/v1/dashboard/channels/{channel_id}": {
      "get": {
        "operationId": "getDashboard",
        "tags": [
          "dashboard"
        ],
        "x-implementation-status": "planned",
        "security": [
          {
            "StreamerSession": []
          }
        ],
