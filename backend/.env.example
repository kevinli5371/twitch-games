# Copy to .env in this directory; run the backend from backend/.
TWITCH_GAMES_ENVIRONMENT=local
TWITCH_GAMES_DOCS_ENABLED=true
TWITCH_GAMES_CORS_ORIGINS=[]
TWITCH_GAMES_DATABASE_CONNECT_TIMEOUT_SECONDS=3
TWITCH_GAMES_DATABASE_POOL_SIZE=5

# Supabase PostgreSQL URI, not a project HTTPS URL or Data API key.
# Direct or session-pooler connection recommended for migrations.
# TWITCH_GAMES_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Twitch Developer Console -> Applications -> your OAuth application.
# Register the callback below exactly, including /api/v1/auth/.
# TWITCH_GAMES_TWITCH_CLIENT_ID="YOUR_OAUTH_APP_CLIENT_ID"
# TWITCH_GAMES_TWITCH_CLIENT_SECRET="YOUR_OAUTH_APP_CLIENT_SECRET"
# TWITCH_GAMES_TWITCH_REDIRECT_URI="http://localhost:8000/api/v1/auth/twitch/callback"
# Generate once: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep stable across restarts; changing it invalidates existing encrypted sessions.
# TWITCH_GAMES_TOKEN_ENCRYPTION_KEY="YOUR_GENERATED_FERNET_KEY"
# Optional dashboard destination after login; actual frontend address may differ.
# TWITCH_GAMES_DASHBOARD_URL="http://localhost:4173"

# Twitch Developer Console -> Extensions -> your Extension (separate from OAuth app).
# Shared secret is copied in its original base64 form; do not decode it here.
# TWITCH_GAMES_TWITCH_EXTENSION_CLIENT_ID="YOUR_EXTENSION_CLIENT_ID"
# TWITCH_GAMES_TWITCH_EXTENSION_SECRET="YOUR_BASE64_EXTENSION_SHARED_SECRET"
# Numeric Twitch account ID that owns the Extension; used for EBS PubSub signing.
# TWITCH_GAMES_TWITCH_EXTENSION_OWNER_ID="YOUR_NUMERIC_TWITCH_USER_ID"

# Set CORS_ORIGINS to a JSON list of actual frontend origins, e.g.
# ["http://localhost:4173","https://EXTENSION_CLIENT_ID.ext-twitch.tv"]
# Production: environment=production, docs_enabled=false, HTTPS origins/callback/dashboard.
# Serve dashboard and API on the same site for the HttpOnly SameSite=Lax OAuth cookie.
# TEST_TWITCH_BASE_URL and TEST_DATABASE_URL are test-harness-only; omit from .env.
