# Copy to backend/.env; run commands from backend/.
TWITCH_GAMES_ENVIRONMENT=local
TWITCH_GAMES_DOCS_ENABLED=true
# JSON array of exact browser origins; empty means no cross-origin browser access.
TWITCH_GAMES_CORS_ORIGINS=[]

# Step 1 does not connect to Supabase or Twitch and needs no credentials.
# Production mode requires docs disabled and at least one explicit HTTPS origin.
