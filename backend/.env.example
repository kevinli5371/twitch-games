# Copy to backend/.env; run commands from backend/.
TWITCH_GAMES_ENVIRONMENT=local
TWITCH_GAMES_DOCS_ENABLED=true
# JSON array of exact browser origins; empty means no cross-origin browser access.
TWITCH_GAMES_CORS_ORIGINS=[]

# PostgreSQL URI, not a Supabase project HTTPS URL or Data API secret key.
# Omit to run with database status not_configured.
# TWITCH_GAMES_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Use the direct or session-pooler connection for migrations.
# TWITCH_GAMES_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# TWITCH_GAMES_DATABASE_POOL_SIZE=5

# Production mode requires docs disabled and at least one explicit HTTPS origin.
